{
  "name": "video-website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Video Website — a short-form learning/play video app. Next.js (App Router) on Vercel with Supabase Postgres and Supabase Auth.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "find app lib -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print0 | xargs -0 node --import tsx --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run lint && npm run typecheck",
    "db:setup": "tsx db/setup.ts",
    "db:seed": "tsx db/seed.ts",
    "db:migrate:check": "node scripts/supabase-migrate.mjs --dry-run",
    "vercel-build": "npm run check && node scripts/supabase-migrate.mjs --vercel-build && next build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.67",
    "@flags-sdk/vercel": "^1.4.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@leafer-in/editor": "2.1.10",
    "@leafer-in/interface": "2.1.10",
    "@leafer-in/resize": "2.1.10",
    "@leafer-in/scroll": "2.1.10",
    "@leafer-ui/core": "2.1.10",
    "@leafer-ui/draw": "2.1.10",
    "@leafer-ui/interface": "2.1.10",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorthief": "^3.5.0",
    "flags": "^4.3.0",
    "leafer-editor": "2.1.10",
    "lucide-react": "^0.468.0",
    "motion": "^12.41.0",
    "next": "^16.0.0",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-progressive-blur": "^1.0.6",
    "react-reconciler": "^0.33.0",
    "shadcn": "^4.17.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/react-reconciler": "^0.33.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "supabase": "2.114.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
